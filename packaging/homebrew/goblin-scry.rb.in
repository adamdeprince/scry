# SPDX-License-Identifier: GPL-3.0-only
class GoblinScry < Formula
  desc "RDP, VNC, X11 and Wayland desktops inside a Kitty graphics terminal"
  homepage "https://scry.goblinreactor.com/"
  url "https://brew.goblinreactor.com/releases/goblin-scry-@VERSION@/@ARCHIVE@"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "GPL-3.0-only"

  depends_on :macos
  depends_on arch: :arm64
  depends_on macos: :tahoe
  depends_on "openssl@3"
  depends_on "jpeg-turbo"

  livecheck do
    skip "Native release archives are published by the Goblin Reactor maintainer"
  end

  def install
    odie "This native archive requires Homebrew in /opt/homebrew" unless HOMEBREW_PREFIX.to_s == "/opt/homebrew"
    bin.install "bin/goblin-scry"
    (lib/"goblin-scry").install Dir["lib/goblin-scry/*"]
    doc.install Dir["share/doc/goblin-scry/*"]
  end

  test do
    assert_equal "goblin-scry #{version}\n", shell_output("#{bin}/goblin-scry --version")
    assert_match "FreeRDP3 LibVNCClient", shell_output("#{bin}/goblin-scry --help")
  end
end
